TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DATABASE_URL=
# Optional, must point to a disposable PostgreSQL database used only by tests.
TEST_DATABASE_URL=
ALLOWED_CHAT_IDS=
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_TIMEOUT_SECONDS=20
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
DATABASE_CONNECT_TIMEOUT_SECONDS=10
MAX_MESSAGE_LENGTH=1000
AI_REQUESTS_PER_MINUTE=10
# Set to false to stop storing raw Telegram transaction text for new records.
STORE_ORIGINAL_TEXT=true
