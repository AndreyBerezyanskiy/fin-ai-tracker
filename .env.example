TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DATABASE_URL=
# Optional, must point to a disposable PostgreSQL database used only by tests.
TEST_DATABASE_URL=
ALLOWED_CHAT_IDS=
# Telegram user IDs allowed to approve access and create invitation links.
ADMIN_USER_IDS=
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_TIMEOUT_SECONDS=20
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
DATABASE_CONNECT_TIMEOUT_SECONDS=10
MAX_MESSAGE_LENGTH=1000
AI_REQUESTS_PER_MINUTE=10
# Master switch. The admin menu can pause voice only while this remains true.
VOICE_INPUT_ENABLED=false
VOICE_REQUESTS_PER_MINUTE=5
MAX_VOICE_DURATION_SECONDS=60
MAX_VOICE_FILE_SIZE_BYTES=5000000
# Set to false to stop storing raw Telegram transaction text for new records.
STORE_ORIGINAL_TEXT=true
# Worker liveness marker used by the Docker HEALTHCHECK.
WORKER_HEARTBEAT_FILE=/tmp/family-finance-worker.heartbeat
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
